{
  "name": "pioarduino & Pi Agent",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "platformio-ide.useBuiltinPIOCore": false
      },
      "extensions": [
        "pioarduino.pioarduino-ide",
        "ms-vscode.cpptools"
      ]
    }
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=termona-pi-agent,target=/workspaces/pi-tools/pi/agent,type=volume",
    "source=termona-pioarduino,target=/home/vscode/.platformio,type=volume"
  ],
  "remoteEnv": {
    "PI_CODING_AGENT_DIR": "/workspaces/pi-tools/pi/agent",
    "PLATFORMIO_CORE_DIR": "/home/vscode/.platformio"
  },
  "postCreateCommand": "sudo mkdir -p /workspaces/pi-tools/pi/agent /home/vscode/.platformio && sudo chown -R vscode:vscode /workspaces/pi-tools /home/vscode/.platformio && bash .devcontainer/post-create.sh"
}
